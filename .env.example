# .env.example — copy to .env and fill values
# See README.md for realtime and Clerk setup notes

# Clerk (client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Clerk (server) — required for server-side token verification
CLERK_SECRET_KEY=""

# MongoDB connection string (required)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB_URI=""

# Upstash/Redis for realtime pub/sub (recommended)
# Must start with redis:// or rediss://
UPSTASH_REDIS_URL="rediss://default:gQAAAAAAAVw_AAIncDI3YjZjMmU1ZWM1ZGY0ZTJlYmVjZWNlZGM2MDhjMTA3MXAyODkxNTE@precise-dingo-89151.upstash.io:6379"
# Optional fallback env name used by the code
REDIS_URL="rediss://default:gQAAAAAAAVw_AAIncDI3YjZjMmU1ZWM1ZGY0ZTJlYmVjZWNlZGM2MDhjMTA3MXAyODkxNTE@precise-dingo-89151.upstash.io:6379"

# Clerk webhook signing secret (optional, if using Clerk webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=""

# Optional runtime hint
# NODE_ENV=development

# Notes:
# - If UPSTASH_REDIS_URL is empty, realtime delivery via Redis is disabled
#   and the app falls back to polling behavior for messages.